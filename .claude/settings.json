{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "PowerShell(npm install)",
      "Bash(npm test *)",
      "PowerShell(npm test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)"
    ]
  }
}
